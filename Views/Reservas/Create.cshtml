@model Hotel.Web.Models.Reserva
@{
    ViewData["Title"] = "Nueva reserva";
    var huespedes = ViewBag.Huespedes as List<Hotel.Web.Models.Huesped> ?? new List<Hotel.Web.Models.Huesped>();
    var habitaciones = ViewBag.Habitaciones as List<Hotel.Web.Models.Habitacion> ?? new List<Hotel.Web.Models.Habitacion>();
}

<h1>Nueva reserva</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="HuespedId" class="form-label">Huésped</label>
                <select asp-for="HuespedId" class="form-select">
                    <option value="">-- Seleccione un huésped --</option>
                    @foreach (var huesped in huespedes)
                    {
                        <option value="@huesped.HuespedId">@huesped.Apellido, @huesped.Nombre - @huesped.Dni</option>
                    }
                </select>
                <span asp-validation-for="HuespedId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HabitacionId" class="form-label">Habitación</label>
                <select asp-for="HabitacionId" class="form-select">
                    <option value="">-- Seleccione una habitación --</option>
                    @foreach (var habitacion in habitaciones)
                    {
                        <option value="@habitacion.HabitacionId">@habitacion.Numero - @habitacion.TipoHabitacion.Nombre (@habitacion.TipoHabitacion.Precio.ToString("C"))</option>
                    }
                </select>
                <span asp-validation-for="HabitacionId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaIngreso" class="form-label"></label>
                <input asp-for="FechaIngreso" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="FechaIngreso" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaSalida" class="form-label"></label>
                <input asp-for="FechaSalida" type="date" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                <span asp-validation-for="FechaSalida" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Observaciones" class="form-label"></label>
                <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="200"></textarea>
                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar reserva</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
