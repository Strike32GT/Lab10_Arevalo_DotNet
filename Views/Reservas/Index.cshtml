@model IEnumerable<Hotel.Web.Models.Reserva>
@{
    ViewData["Title"] = "Reservas";
}

<h1>Reservas</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn btn-success">Nueva reserva</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Huésped</th>
            <th>Habitación</th>
            <th>Ingreso</th>
            <th>Salida</th>
            <th>Noches</th>
            <th>Estado</th>
            <th>Total</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No hay reservas registradas.</td>
            </tr>
        }
        @foreach (var reserva in Model)
        {
            var noches = reserva.FechaSalida.DayNumber - reserva.FechaIngreso.DayNumber;
            var total = noches * reserva.Habitacion.TipoHabitacion.Precio;
            var claseEstado = reserva.Estado switch
            {
                "Confirmada" => "bg-success",
                "Pendiente" => "bg-warning text-dark",
                "Cancelada" => "bg-secondary",
                "Finalizada" => "bg-primary",
                _ => "bg-light text-dark"
            };
            <tr>
                <td>@reserva.Huesped.Apellido, @reserva.Huesped.Nombre</td>
                <td>@reserva.Habitacion.Numero - @reserva.Habitacion.TipoHabitacion.Nombre</td>
                <td>@reserva.FechaIngreso.ToString("dd/MM/yyyy")</td>
                <td>@reserva.FechaSalida.ToString("dd/MM/yyyy")</td>
                <td>@noches</td>
                <td><span class="badge @claseEstado">@reserva.Estado</span></td>
                <td>@total.ToString("C")</td>
                <td class="text-end">
                    @if (reserva.Estado == "Pendiente" || reserva.Estado == "Confirmada")
                    {
                        <form asp-action="Cancelar" asp-route-id="@reserva.ReservaId" method="post" class="d-inline"
                              onsubmit="return confirm('¿Seguro que deseas cancelar esta reserva?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
