@model IEnumerable<Hotel.Web.Models.Habitacion>
@{
    ViewData["Title"] = "Habitaciones";
    var tipos = ViewBag.Tipos as List<Hotel.Web.Models.TipoHabitacion> ?? new List<Hotel.Web.Models.TipoHabitacion>();
    int? tipoId = ViewBag.TipoId;
}

<h1>Habitaciones</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="tipoId">Tipo de habitación</label>
        <select id="tipoId" name="tipoId" class="form-select">
            <option value="">Todos los tipos</option>
            @foreach (var tipo in tipos)
            {
                <option value="@tipo.TipoHabitacionId" selected="@(tipoId == tipo.TipoHabitacionId)">@tipo.Nombre</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
    <div class="col text-end">
        <a asp-action="Create" class="btn btn-success">Nueva habitación</a>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Número</th>
            <th>Tipo</th>
            <th>Piso</th>
            <th>Precio por noche</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No hay habitaciones activas para mostrar.</td>
            </tr>
        }
        @foreach (var habitacion in Model)
        {
            <tr>
                <td>@habitacion.Numero</td>
                <td>@habitacion.TipoHabitacion.Nombre</td>
                <td>@habitacion.Piso</td>
                <td>@habitacion.TipoHabitacion.Precio.ToString("C")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@habitacion.HabitacionId" class="btn btn-sm btn-outline-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@habitacion.HabitacionId" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@habitacion.HabitacionId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
