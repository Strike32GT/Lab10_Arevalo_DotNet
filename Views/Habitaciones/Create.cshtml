@model Hotel.Web.Models.Habitacion
@{
    ViewData["Title"] = "Nueva habitación";
    var tipos = ViewBag.Tipos as List<Hotel.Web.Models.TipoHabitacion> ?? new List<Hotel.Web.Models.TipoHabitacion>();
}

<h1>Nueva habitación</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Numero" class="form-label"></label>
                <input asp-for="Numero" class="form-control" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TipoHabitacionId" class="form-label">Tipo de habitación</label>
                <select asp-for="TipoHabitacionId" class="form-select">
                    <option value="">-- Seleccione un tipo --</option>
                    @foreach (var tipo in tipos)
                    {
                        <option value="@tipo.TipoHabitacionId">@tipo.Nombre (@tipo.Precio.ToString("C"))</option>
                    }
                </select>
                <span asp-validation-for="TipoHabitacionId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Piso" class="form-label"></label>
                <input asp-for="Piso" class="form-control" />
                <span asp-validation-for="Piso" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
