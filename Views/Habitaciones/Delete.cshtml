@model Hotel.Web.Models.Habitacion
@{
    ViewData["Title"] = "Eliminar habitación";
}

<h1>Eliminar habitación</h1>

<div class="alert alert-warning">
    La eliminación es lógica: la habitación dejará de mostrarse, pero sus datos se conservan.
</div>

<dl class="row">
    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@Model.Numero</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.TipoHabitacion.Nombre</dd>

    <dt class="col-sm-3">Piso</dt>
    <dd class="col-sm-9">@Model.Piso</dd>
</dl>

    <form asp-action="Delete" asp-route-id="@Model.HabitacionId">
    <input type="hidden" asp-for="HabitacionId" />
    <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
